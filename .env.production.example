POSTGRES_USER=tide
POSTGRES_PASSWORD=replace_with_a_strong_database_password
POSTGRES_DB=tide

# Caddy 是唯一对外入口。真实域名会自动申请/续期 HTTPS 证书。
SITE_ADDRESS=tide.example.com
HTTP_PORT=80
HTTPS_PORT=443
PUBLIC_ORIGIN=https://tide.example.com

# 应用镜像不写在此文件。部署时同时加载 Release 附带的 release-images.env，
# 其中四个镜像均使用不可变 sha256 digest。
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

AUTH_SECRET=replace_with_a_random_secret_of_at_least_32_chars
BOOTSTRAP_TOKEN=replace_with_a_one_time_bootstrap_token
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_LOGIN_IP_LIMIT=30
AUTH_LOGIN_ACCOUNT_LIMIT=8
AUTH_BOOTSTRAP_IP_LIMIT=5

AGENT_MODE=mock
ENABLE_PASCAL_EXECUTION=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_INPUT_COST_PER_MILLION_USD=0
DEEPSEEK_OUTPUT_COST_PER_MILLION_USD=0

MATTERMOST_SLASH_TOKEN=
MATTERMOST_TEACHER_USERNAME=
MATTERMOST_ACTION_URL=

LOG_HEALTH_REQUESTS=false
LOG_ERROR_DETAILS=false
