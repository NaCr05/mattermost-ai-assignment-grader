POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_local_database_password
POSTGRES_DB=tide_final
POSTGRES_PORT=5434

BACKEND_PORT=3001
FRONTEND_PORT=5173
AGENT_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# 首次启动前替换为随机值；AUTH_SECRET 至少 32 个字符。
AUTH_SECRET=replace_with_a_random_secret_of_at_least_32_chars
BOOTSTRAP_TOKEN=replace_with_a_one_time_bootstrap_token
# 仅在 HTTPS 部署时设为 true。
AUTH_COOKIE_SECURE=false
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_LOGIN_IP_LIMIT=30
AUTH_LOGIN_ACCOUNT_LIMIT=8
AUTH_BOOTSTRAP_IP_LIMIT=5

AGENT_MODE=mock
ENABLE_PASCAL_EXECUTION=false
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_TIMEOUT_SECONDS=60
# 按供应商当前计费填写；默认 0 表示只记录 Token，不估算费用。
DEEPSEEK_INPUT_COST_PER_MILLION_USD=0
DEEPSEEK_OUTPUT_COST_PER_MILLION_USD=0

MATTERMOST_SLASH_TOKEN=replace_with_mattermost_token
MATTERMOST_TEACHER_USERNAME=your_mattermost_teacher_username
# 可选：Mattermost Server 能访问到的完整交互回调地址。
# 留空时，后端会根据 Slash Command 请求的 Host 自动生成。
MATTERMOST_ACTION_URL=

# 默认不记录 Docker 每 5 秒一次的 /health 请求，避免日志噪音。
LOG_HEALTH_REQUESTS=false
# 仅在受控本地调试时开启；默认避免日志泄露上游错误和本机路径。
LOG_ERROR_DETAILS=false
